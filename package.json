{
  "name": "qrapido",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed:staff-admin": "tsc --target es2022 --module commonjs --moduleResolution node --strict --esModuleInterop --skipLibCheck scripts/bootstrap-staff-admin.ts --outDir .tmp/scripts && node .tmp/scripts/bootstrap-staff-admin.js",
    "audit:staff": "tsc --target es2022 --module commonjs --moduleResolution node --strict --esModuleInterop --skipLibCheck scripts/audit-staff-users.ts --outDir .tmp/scripts && node .tmp/scripts/audit-staff-users.js",
    "test": "node --test tests/*.test.mjs && npm run test:integration",
    "test:integration": "tsx --tsconfig tests/integration/tsconfig.json --test tests/integration/*.test.ts",
    "firebase:deploy": "npx --yes firebase-tools@13 deploy --only firestore"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^11.3.30",
    "lucide-react": "^0.468.0",
    "next": "^15.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.13.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.8.2",
  "overrides": {
    "jwks-rsa": "3.2.2"
  }
}
