{
  "name": "qrapido",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed:staff-admin": "tsc --target es2022 --module commonjs --moduleResolution node --strict --esModuleInterop --skipLibCheck scripts/bootstrap-staff-admin.ts --outDir .tmp/scripts && node .tmp/scripts/bootstrap-staff-admin.js",
    "audit:staff": "tsc --target es2022 --module commonjs --moduleResolution node --strict --esModuleInterop --skipLibCheck scripts/audit-staff-users.ts --outDir .tmp/scripts && node .tmp/scripts/audit-staff-users.js",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "clsx": "^2.1.1",
    "firebase": "^10.14.1",
    "firebase-admin": "^12.6.0",
    "framer-motion": "^11.3.30",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.13.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.8.2"
}
