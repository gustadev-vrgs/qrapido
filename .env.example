# ---------------------------------------------------------------
# Firebase do site (navegador). Firebase → Configurações do projeto
# → Seus apps → app Web → "Configuração do SDK".
# ---------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------
# Firebase Admin (somente servidor). Firebase → Configurações do projeto
# → Contas de serviço → "Gerar nova chave privada" (baixa um .json).
#
# Opção A (recomendada): cole o conteúdo INTEIRO do .json numa única variável.
# (Na Vercel pode colar com quebras de linha; no .env.local deixe numa linha só.)
FIREBASE_SERVICE_ACCOUNT=
#
# Opção B: três variáveis separadas, copiadas do mesmo .json.
# Aspas e "\n" na chave são aceitos.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# ---------------------------------------------------------------

# Endereço público usado nos QR Codes. Pode ficar vazio: o painel usa o
# endereço em que está aberto. Nunca deixe o exemplo "seu-dominio".
NEXT_PUBLIC_APP_URL=

# Fuso horário do restaurante (separa os pedidos por dia).
NEXT_PUBLIC_RESTAURANT_TIME_ZONE=America/Sao_Paulo

# E-mails (separados por vírgula) de quem cadastra novos restaurantes em /plataforma.
# O e-mail precisa estar confirmado no Firebase Auth. Vazio = área desativada.
PLATFORM_ADMIN_EMAILS=
