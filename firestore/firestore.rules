rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRestaurantClaim() {
      return isSignedIn() && request.auth.token.restaurantId is string;
    }

    function isRestaurantUser(restaurantId) {
      return hasRestaurantClaim() && request.auth.token.restaurantId == restaurantId;
    }

    function isRestaurantDoc(data, restaurantId) {
      return data.restaurantId is string && data.restaurantId == restaurantId;
    }

    function staffUserDoc() {
      return get(/databases/$(database)/documents/staffUsers/$(request.auth.uid));
    }

    function hasActiveStaffForRestaurant(restaurantId) {
      return isSignedIn()
        && staffUserDoc().data.uid == request.auth.uid
        && staffUserDoc().data.isActive == true
        && staffUserDoc().data.restaurantId == restaurantId;
    }

    match /restaurants/{restaurantId} {
      allow read: if isRestaurantUser(restaurantId) || hasActiveStaffForRestaurant(restaurantId);
      allow create, update: if isRestaurantUser(restaurantId) && isRestaurantDoc(request.resource.data, restaurantId);
      allow delete: if false;
    }

    match /staffUsers/{staffId} {
      allow read: if isSignedIn() && (
        request.auth.uid == staffId ||
        resource.data.uid == request.auth.uid ||
        (resource.data.restaurantId is string && (isRestaurantUser(resource.data.restaurantId) || hasActiveStaffForRestaurant(resource.data.restaurantId)))
      );
      allow create, update: if request.resource.data.uid is string
        && request.resource.data.restaurantId is string
        && (
          (hasRestaurantClaim() && isRestaurantUser(request.resource.data.restaurantId))
          || hasActiveStaffForRestaurant(request.resource.data.restaurantId)
        );
      allow delete: if false;
    }

    match /{collection}/{docId} {
      allow read: if (
          hasRestaurantClaim() && isRestaurantDoc(resource.data, request.auth.token.restaurantId)
        ) || (
          resource.data.restaurantId is string && hasActiveStaffForRestaurant(resource.data.restaurantId)
        );
      allow create: if (
          hasRestaurantClaim() && isRestaurantDoc(request.resource.data, request.auth.token.restaurantId)
        ) || (
          request.resource.data.restaurantId is string && hasActiveStaffForRestaurant(request.resource.data.restaurantId)
        );
      allow update: if (
          hasRestaurantClaim()
          && isRestaurantDoc(resource.data, request.auth.token.restaurantId)
          && isRestaurantDoc(request.resource.data, request.auth.token.restaurantId)
        ) || (
          resource.data.restaurantId is string
          && request.resource.data.restaurantId is string
          && hasActiveStaffForRestaurant(resource.data.restaurantId)
          && resource.data.restaurantId == request.resource.data.restaurantId
        );
      allow delete: if false;
    }

    match /tableSessions/{sessionId} {
      allow read: if true;
      allow create: if (
          hasRestaurantClaim() && isRestaurantDoc(request.resource.data, request.auth.token.restaurantId)
        ) || (
          request.resource.data.restaurantId is string && hasActiveStaffForRestaurant(request.resource.data.restaurantId)
        );
      allow update: if (
          hasRestaurantClaim()
          && isRestaurantDoc(resource.data, request.auth.token.restaurantId)
          && isRestaurantDoc(request.resource.data, request.auth.token.restaurantId)
        ) || (
          resource.data.restaurantId is string
          && request.resource.data.restaurantId is string
          && hasActiveStaffForRestaurant(resource.data.restaurantId)
          && resource.data.restaurantId == request.resource.data.restaurantId
        );
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.restaurantId is string
        && request.resource.data.sessionId is string
        && request.resource.data.duplicateGuardHash is string;
      allow read, update: if hasRestaurantClaim()
        && isRestaurantDoc(resource.data, request.auth.token.restaurantId)
        && (
          request.method == 'get' ||
          isRestaurantDoc(request.resource.data, request.auth.token.restaurantId)
        );
      allow delete: if false;
    }
  }
}
