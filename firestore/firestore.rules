rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function staffUserDoc() { return get(/databases/$(database)/documents/staffUsers/$(request.auth.uid)); }
    function isActiveStaff() {
      return isSignedIn()
        && staffUserDoc().data.uid == request.auth.uid
        && staffUserDoc().data.isActive == true
        && staffUserDoc().data.restaurantId is string;
    }
    function staffRestaurantId() { return staffUserDoc().data.restaurantId; }
    function staffRole() { return staffUserDoc().data.role; }
    function isStaffForRestaurant(restaurantId) { return isActiveStaff() && staffRestaurantId() == restaurantId; }
    function isAdminForRestaurant(restaurantId) { return isStaffForRestaurant(restaurantId) && staffRole() in ['admin', 'manager']; }
    function isOwnerAdminForRestaurant(restaurantId) { return isStaffForRestaurant(restaurantId) && staffRole() == 'admin'; }
    function isKitchenOrAdminForRestaurant(restaurantId) { return isStaffForRestaurant(restaurantId) && staffRole() in ['admin', 'manager', 'kitchen']; }
    function canOperateOrders(restaurantId) { return isStaffForRestaurant(restaurantId) && staffRole() in ['admin', 'manager', 'attendant', 'kitchen']; }
    function isRestaurantDoc(data, restaurantId) { return data.restaurantId is string && data.restaurantId == restaurantId; }
    function sameRestaurant() { return resource.data.restaurantId is string && request.resource.data.restaurantId == resource.data.restaurantId; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // The panel only edits a table's number, name and capacity, and reactivates a disabled
    // table (status back to "free", no attendance). Opening, closing and codes go through the server.
    function isTableEdit() {
      return changedKeys().hasOnly(['number', 'label', 'capacity', 'isActive', 'status', 'currentSessionGroupId', 'updatedAt'])
        && (!changedKeys().hasAny(['status']) || request.resource.data.status == 'free')
        && (!changedKeys().hasAny(['currentSessionGroupId']) || request.resource.data.currentSessionGroupId == null);
    }

    match /restaurants/{restaurantId} {
      // The document id is the restaurantId; the second clause also lets the panel
      // find restaurant documents created by older versions with a random id.
      allow read: if isStaffForRestaurant(restaurantId)
        || (resource.data.restaurantId is string && isStaffForRestaurant(resource.data.restaurantId));
      allow create, update: if isAdminForRestaurant(restaurantId) && isRestaurantDoc(request.resource.data, restaurantId);
      allow delete: if false;
    }

    match /staffUsers/{staffId} {
      allow read: if isSignedIn() && (request.auth.uid == staffId ||
        (resource.data.restaurantId is string && isOwnerAdminForRestaurant(resource.data.restaurantId)));
      allow create: if staffId == request.resource.data.uid
        && request.resource.data.restaurantId is string
        && isOwnerAdminForRestaurant(request.resource.data.restaurantId)
        && request.resource.data.role in ['admin', 'manager', 'attendant', 'kitchen'];
      allow update: if resource.data.restaurantId is string
        && sameRestaurant()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role in ['admin', 'manager', 'attendant', 'kitchen']
        && isOwnerAdminForRestaurant(resource.data.restaurantId)
        && (staffId != request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'updatedAt']));
      allow delete: if false;
    }

    match /restaurantSettings/{settingsId} {
      allow read: if resource.data.restaurantId is string && isStaffForRestaurant(resource.data.restaurantId);
      allow create: if request.resource.data.restaurantId is string && isAdminForRestaurant(request.resource.data.restaurantId);
      allow update: if resource.data.restaurantId is string && sameRestaurant() && isAdminForRestaurant(resource.data.restaurantId);
      allow delete: if false;
    }

    match /menuCategories/{categoryId} {
      allow read: if resource.data.restaurantId is string && isStaffForRestaurant(resource.data.restaurantId);
      allow create: if request.resource.data.restaurantId is string && isAdminForRestaurant(request.resource.data.restaurantId);
      allow update: if resource.data.restaurantId is string && sameRestaurant() && isAdminForRestaurant(resource.data.restaurantId);
      allow delete: if false;
    }

    match /menuItems/{itemId} {
      allow read: if resource.data.restaurantId is string && isStaffForRestaurant(resource.data.restaurantId);
      allow create: if request.resource.data.restaurantId is string && isAdminForRestaurant(request.resource.data.restaurantId);
      allow update: if resource.data.restaurantId is string && sameRestaurant() && isAdminForRestaurant(resource.data.restaurantId);
      allow delete: if false;
    }

    match /tables/{tableId} {
      allow read: if resource.data.restaurantId is string && isStaffForRestaurant(resource.data.restaurantId);
      // A new table starts free and without attendance.
      allow create: if request.resource.data.restaurantId is string && isAdminForRestaurant(request.resource.data.restaurantId)
        && request.resource.data.status == 'free' && request.resource.data.currentSessionGroupId == null;
      allow update: if resource.data.restaurantId is string && sameRestaurant() && isAdminForRestaurant(resource.data.restaurantId) && isTableEdit();
      allow delete: if false;
    }

    // Attendances are opened, renewed and closed only by the server APIs, which keep
    // "one open attendance per table", the access code hash and the bill consistent.
    match /tableSessions/{sessionId} {
      allow read: if resource.data.restaurantId is string && isStaffForRestaurant(resource.data.restaurantId);
      allow create, update, delete: if false;
    }

    // Credenciais públicas e contadores de tentativa são acessíveis somente pelo
    // servidor Admin; nem clientes anônimos nem SDKs de staff recebem esses dados.
    match /sessionAccessGrants/{grantId} {
      allow read, write: if false;
    }

    // Contadores e reservas de segurança são exclusivos das APIs Admin.
    match /publicRateLimits/{limitId} { allow read, write: if false; }
    match /orderIdempotency/{keyId} { allow read, write: if false; }

    match /orders/{orderId} {
      allow read: if resource.data.restaurantId is string && isStaffForRestaurant(resource.data.restaurantId);
      // Order creation and state transitions are server-only. The trusted APIs
      // validate session/table concurrency, prices, quota and transition graph.
      // The formerly client-writable set was: hasOnly(['status', 'confirmedAt', 'preparationStartedAt', 'readyAt', 'deliveredAt', 'cancelledAt', 'updatedAt']).
      allow create, update: if false;
      allow delete: if false;
    }

    // Audit trail: written only by the server, so nobody can forge or erase history.
    match /orderEvents/{eventId} {
      allow read: if resource.data.restaurantId is string && isStaffForRestaurant(resource.data.restaurantId);
      allow create, update, delete: if false;
    }

    // Sensitive team actions (people, access, data cleanup). Written only by the server, never deleted.
    match /auditLog/{entryId} {
      allow read: if resource.data.restaurantId is string && isAdminForRestaurant(resource.data.restaurantId);
      allow create, update, delete: if false;
    }

    match /dailyMetrics/{metricId} {
      allow read: if resource.data.restaurantId is string && isStaffForRestaurant(resource.data.restaurantId);
      allow create, update, delete: if false;
    }

    match /adminAlerts/{alertId} {
      allow read: if resource.data.restaurantId is string && isStaffForRestaurant(resource.data.restaurantId);
      allow create: if false;
      allow update: if resource.data.restaurantId is string && sameRestaurant()
        && isStaffForRestaurant(resource.data.restaurantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']);
      allow delete: if false;
    }

    // Criados pelo cliente e operados pela equipe exclusivamente por APIs
    // autenticadas no servidor, que também registram a trilha de auditoria.
    match /waiterCalls/{callId} { allow read, write: if false; }
    match /waiterCallLocks/{lockId} { allow read, write: if false; }
  }
}
